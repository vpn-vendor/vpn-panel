# Скопировать в .env для DEV. Файл .env не коммитить НИКОГДА.
#
# На клиенте этот файл не используется —
# конфиг /etc/vpn-panel/panel.env генерируется установщиком пакета сам,
# включая уникальный APP_KEY. Клиент ничего не заполняет руками.
APP_NAME="VPN Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug
# Путь логов: в DEV относительный; на клиенте /var/log/vpn-panel/panel.log
LOG_PATH=storage/logs/vpn-panel.log

SESSION_DRIVER=file
SESSION_LIFETIME=120

# HTTPS обязателен: контент только на APP_TLS_PORT,
# APP_PORT — лишь редирект http→https. DEV = прод.
# Адреса привязки переменной не задаются: панель выбирает их
# сама; в сборке с тегом dev (make dev) слушает все адреса контейнера.
APP_URL=https://127.0.0.1:8443
APP_PORT=8080
APP_TLS_PORT=8443
APP_EXTERNAL_TLS_PORT=
TLS_CERT=storage/framework/tls/cert.pem
TLS_KEY=storage/framework/tls/key.pem

DB_CONNECTION=sqlite
DB_DATABASE=storage/app/panel.sqlite

# Unix-сокет root-агента. Путь для разработки; в пакете — /run/vpn-panel/broker.sock
AGENT_SOCKET=storage/framework/broker.sock

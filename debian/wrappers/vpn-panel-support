#!/bin/sh
# Сведения для поддержки для человека у экрана шлюза: работает и тогда,
# когда панель не запускается. Готовый файл кладётся в домашнюю папку того,
# кто подтвердил права.
set -e
if [ "$(id -u)" -ne 0 ]; then
    echo "Запустите с правами администратора: sudo vpn-panel-support" >&2
    exit 1
fi
FILE="$(/usr/sbin/vpn-agent support)"
case "$FILE" in
    /run/vpn-panel/vpn-panel-support-*) ;;
    *) echo "Сведения не собраны — повторите; если повторяется, обратитесь в поддержку." >&2; exit 1 ;;
esac
# Кто вызвал: окно подтверждения прав сообщает номер, sudo — имя.
WHO=""
if [ -n "${PKEXEC_UID:-}" ]; then
    WHO="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
elif [ -n "${SUDO_USER:-}" ]; then
    WHO="$SUDO_USER"
fi
[ -n "$WHO" ] || WHO=root
HOME_DIR="$(getent passwd "$WHO" | cut -d: -f6)"
[ -d "$HOME_DIR" ] || { echo "У учётной записи нет домашней папки — файл остался в $FILE" >&2; exit 1; }
DEST="$HOME_DIR/$(basename "$FILE")"
# SEC: 0600 и владелец — тот, кто запросил; чужим файл не виден.
install -m 0600 -o "$WHO" -g "$(id -gn "$WHO")" "$FILE" "$DEST"
echo "$DEST"

#!/bin/sh
# Выдать одноразовый код входа и адрес страницы для рабочего стола сервера.
# Запускается только через штатный механизм подтверждения прав системы
# (см. правило com.vpn_vendor.panel.desktop-login): он проверяет, что за
# машиной действительно сидит администратор.
#
# Печатает ровно две строки: адрес страницы входа с кодом и сам код.
set -e
if [ "$(id -u)" -ne 0 ]; then
    echo "Нужны права администратора." >&2
    exit 1
fi
set -a
. /etc/vpn-panel/panel.env
set +a
exec runuser -u vpn-admin -- /usr/libexec/vpn-panel/vpn-panel artisan auth:desktop-login

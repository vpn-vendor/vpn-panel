[Unit]
Description=VPN Panel rollback after a failed update
# Жгут, Уровень 3: возвращает панель на прежнюю версию, если новая не прошла
# проверку здоровья. Запускается по требованию (агент по намерению отката или
# нижний сторож цикла падений), сам не включён и при установке не стартует.
# Живёт отдельным юнитом, вне cgroup агента: переустановка пакета заменяет
# бинарник агента, а этот процесс доводит откат.
# Остановить его штатным stop нельзя: пока он ставит прежний пакет, любой
# maintainer-скрипт с остановкой юнита убил бы dpkg на полпути. Аварийно
# прервать можно только kill.
RefuseManualStop=yes
# Без предела стартов: OnFailure зовёт юнит на каждом падении службы, и штатный
# предел отклонил бы его как раз тогда, когда откат нужен. От петли защищают
# счётчик попыток в итоге отката и идемпотентность шагов.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/vpn-panel/vpn-agent rollback
User=root
# Переустанавливает пакет и восстанавливает базу — доступ к системе нужен
# полный, поэтому ProtectSystem не ставим; дом прятать можно.
ProtectHome=yes

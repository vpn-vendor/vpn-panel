# Подключение к провайдеру по логину и паролю: экземпляр на пир pppd.
#
# Свой шаблон вместо родного ppp@.service: в пакете ppp Ubuntu 22.04 юнита
# нет вовсе, а pppd там умеет up_sdnotify. Один юнит на обеих системах —
# один путь надзора. Содержимое то же, что у родного шаблона 26.04, плюс
# ожидание карты и растущая пауза повторов в ExecStartPre.
#
# ПРЕДЕЛА ЧАСТОТЫ СТАРТОВ НЕТ НАМЕРЕННО (StartLimitIntervalSec=0). У
# защищённого канала он есть и там уместен: канал, который не сходится, не
# должен долбить сервер. Здесь всё наоборот — это аплинк офиса. «Сдался»
# означает офис без сети до приезда человека, а провайдер может молчать
# часами: работы на линии, перезагрузка концентратора, авария. Роутер в
# такой ситуации продолжает набирать — и мы продолжаем. Темп держит
# растущая пауза сценария ppp-wait-link, она же бережёт учётную запись у
# оператора от блокировки за частые неудачные проверки.
[Unit]
Description=VPN Panel: PPPoE link %I
Documentation=man:pppd(8)
Before=network.target
StartLimitIntervalSec=0

[Service]
# notify: pppd сообщает READY=1, когда линк реально поднялся (up_sdnotify).
Type=notify
# Перед pppd — дождаться канального интерфейса и выдержать паузу после
# неудач подряд. Срыв ожидания — ошибка процесса, её подхватывает Restart=.
ExecStartPre=/usr/libexec/vpn-panel/ppp-wait-link %I
ExecStart=/usr/sbin/pppd call %I nodetach nolog up_sdnotify
ExecReload=/bin/kill -HUP $MAINPID
# Коды выхода pppd, которые не неудача: сигнал, обрыв по инициативе сторон.
SuccessExitStatus=0 5 12 13 14
Restart=on-failure
# Минимальная пауза systemd; растущую держит сценарий.
RestartSec=1
# Старт включает паузу сценария (до 10 минут), ожидание карты и дозвон.
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target

#!/bin/sh
# Защита раньше сети: вызывается юнитом vpn-panel-firewall.service до того,
# как менеджер сети получит право поднять карты. Только nft и файл — ни базы,
# ни сокета, ни службы панели.
#
# Три исхода:
#  1. Панель ещё не настроена (сохранённых правил нет) — ничего не делаем:
#     до мастера установки офиса за шлюзом нет, пересылка остаётся выключенной.
#  2. Правила загрузились — и ТОЛЬКО ПОСЛЕ ЭТОГО включается пересылка.
#     Раньше её включал файл sysctl на ранней стадии загрузки, до всяких
#     правил: сеть, поднятая ещё до systemd (удалённая разблокировка диска,
#     загрузка по сети), могла пропустить трафик офиса мимо канала.
#  3. Правила есть, но не загрузились (файл испорчен) — аварийный запрет
#     выхода: наружу нельзя, в сеть офиса можно, пересылка выключена.
#     Офис без интернета, но без утечки; администратор входит из LAN и
#     применяет настройки заново (fail-closed). Сначала набор по последней
#     конфигурации (граница по картам), без него — статичный из пакета.
RULES=/etc/nftables.d/vpn-panel.nft
LOCKDOWN_LAST=/etc/vpn-panel/lockdown.nft
LOCKDOWN_STATIC=/usr/share/vpn-panel/lockdown.nft
NFT=/usr/sbin/nft

[ -f "$RULES" ] || exit 0

if "$NFT" -f "$RULES"; then
    echo 1 > /proc/sys/net/ipv4/ip_forward
    echo "vpn-panel: защита загружена раньше сети"
    exit 0
fi

echo 0 > /proc/sys/net/ipv4/ip_forward
if [ -f "$LOCKDOWN_LAST" ] && "$NFT" -f "$LOCKDOWN_LAST"; then
    echo "vpn-panel: сохранённые правила не загрузились — включён аварийный запрет выхода по последней конфигурации; примените настройки в панели" >&2
    exit 0
fi
echo "vpn-panel: сохранённые правила не загрузились — включён статичный аварийный запрет выхода; примените настройки в панели" >&2
"$NFT" -f "$LOCKDOWN_STATIC"

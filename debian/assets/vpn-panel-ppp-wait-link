#!/bin/sh
# Перед pppd: выдержать растущую паузу после неудач подряд и дождаться
# канальной карты (ExecStartPre экземпляра vpn-panel-ppp@, аргумент — имя
# пира).
#
# Пауза. systemd 249 (Ubuntu 22.04) не умеет растущую паузу повторов
# (RestartSteps), поэтому счётчик неудач подряд ведём здесь: файл в /run,
# пауза 10 с × 2^(n-1), не больше 10 минут. Первые попытки быстрые (обычный
# случай — линия моргнула), дальше редкие (необычный — данные не подходят):
# у оператора есть счётчик неудачных проверок, и частые попытки с неверным
# паролем превратили бы опечатку в отключение офиса на сутки. Счётчик
# стирают: хук ip-up при успехе, агент перед запуском с новыми данными,
# перезагрузка сама (это /run).
#
# Карта. Модуль PPPoE в pppd проверяет существование интерфейса уже при
# разборе опций и отвергает отсутствующий (код 2). При загрузке подынтерфейс
# VLAN создаёт менеджер сети позже, чем systemd стартует экземпляр. Имя
# интерфейса берётся из самого пира — единственный источник правды: откат
# пира не может разойтись с тем, чего здесь ждут. Ожидание — событие udev,
# а не опрос; срыв ожидания — ошибка процесса, и Restart= юнита повторит
# попытку с паузой (самопочинка, а не «failed»).
#
# Переменные VPN_PANEL_* — для проверки сценария без системы.
PEER_NAME=${1:-vpn_panel_wan}
case "$PEER_NAME" in ""|*/*|.*) exit 2 ;; esac
PEER=/etc/ppp/peers/$PEER_NAME
RUN=${VPN_PANEL_RUN:-/run/vpn-panel}
FAILS=$RUN/ppp-fails-$PEER_NAME
SLEEP=${VPN_PANEL_SLEEP:-sleep}
# Время: первая пауза, её потолок, срок ожидания карты за одну попытку.
BASE=10
CAP=600
TIMEOUT=120

n=0
[ -f "$FAILS" ] && n=$(cat "$FAILS" 2>/dev/null)
case "$n" in ""|*[!0-9]*) n=0 ;; esac
mkdir -p "$RUN"
echo $((n + 1)) > "$FAILS"
if [ "$n" -gt 0 ]; then
    delay=$BASE
    i=1
    while [ "$i" -lt "$n" ] && [ "$delay" -lt "$CAP" ]; do
        delay=$((delay * 2))
        i=$((i + 1))
    done
    [ "$delay" -gt "$CAP" ] && delay=$CAP
    "$SLEEP" "$delay"
fi

LINK=$(sed -n 's/^plugin pppoe\.so nic-\(.*\)$/\1/p' "$PEER" 2>/dev/null)
[ -n "$LINK" ] || exit 0
[ "${VPN_PANEL_WAIT_LINK:-1}" = 0 ] && exit 0
exec /usr/bin/udevadm wait --timeout="$TIMEOUT" "/sys/class/net/$LINK"

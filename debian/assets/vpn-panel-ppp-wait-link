#!/bin/sh
# Ждать канальный интерфейс PPPoE, прежде чем запускать pppd
# (ExecStartPre экземпляра ppp@vpn_panel_wan).
#
# Модуль PPPoE в pppd проверяет существование интерфейса уже при разборе
# опций и отвергает и «ens3.100», и «nic-ens3.100», если его ещё нет (код 2).
# При загрузке подынтерфейс VLAN создаёт менеджер сети позже, чем systemd
# стартует ppp@, — первый старт падал, и офис ждал повтора 10 секунд.
#
# Имя интерфейса берётся из самого пира — единственный источник правды:
# откат пира не может разойтись с тем, чего здесь ждут. Ожидание — событие
# udev, а не опрос; срыв ожидания — ошибка процесса, и штатный Restart=
# юнита повторит попытку с растущей паузой (самопочинка, а не «failed»).
PEER=/etc/ppp/peers/vpn_panel_wan
# Время: сколько ждать карту за одну попытку. Подынтерфейс появляется за
# секунды; запас на медленное железо, дальше — повтор юнита.
TIMEOUT=120

LINK=$(sed -n 's/^plugin pppoe\.so nic-\(.*\)$/\1/p' "$PEER" 2>/dev/null)
[ -n "$LINK" ] || exit 0
exec /usr/bin/udevadm wait --timeout="$TIMEOUT" "/sys/class/net/$LINK"

[Desktop Entry]
Type=Application
Name=Settings backup code
Name[ru]=Код для копии настроек
Comment=One-time code to download a full settings backup from the panel
Comment[ru]=Одноразовый код, чтобы выгрузить полную копию настроек из панели
Keywords=vpn;panel;backup;
Keywords[ru]=впн;панель;копия;резервная;код;
Exec=/usr/bin/vpn-panel-backup-code-show
Icon=vpn-panel
Terminal=false
Categories=Network;
StartupNotify=true

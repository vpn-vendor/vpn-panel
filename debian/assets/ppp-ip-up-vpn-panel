#!/bin/sh
# Хук pppd: действующий WAN офиса (PPPoE) поднялся.
#
# Ставится пакетом vpn-panel как /etc/ppp/ip-up.d/50vpn-panel и запускается
# демоном pppd от root при подъёме КАЖДОГО ppp-канала в системе. Свой канал
# опознаём по метке ipparam из нашего peer-файла — чужое PPP-подключение
# администратора не трогаем.
#
# Зачем нужен: очередь приоритета звонков (CAKE) живёт только в ядре и
# привязана к интерфейсу. При перезагрузке агент стартует РАНЬШЕ дозвона,
# интерфейса ppp0 в этот момент ещё нет, и без этого события очередь молча не
# вернулась бы до следующего «Применить» — разговоры теряли бы приоритет.
#
# Хук не имеет права уронить подъём канала: любая наша ошибка гасится, выход
# всегда нулевой.
[ "$PPP_IPPARAM" = "vpn_panel_wan" ] || exit 0
/usr/libexec/vpn-panel/vpn-agent wan-up >/dev/null 2>&1 || true
exit 0

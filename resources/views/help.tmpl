{{ define "help.tmpl" }}
{{ template "app-top" . }}

<div class="cols cols-pick" data-pick>
<div class="col">
<nav class="card" aria-label="Вопросы">
    <div class="card-head"><div><h2>Что случилось?</h2></div></div>
    <ul class="pick-list">
        {{ range .topics }}<li><a class="pick-item" href="#{{ .Key }}" data-pick-for="{{ .Key }}"><span>{{ .Question }}</span>{{ template "components/icon" "chevron" }}</a></li>{{ end }}
    </ul>
    <p class="muted">Те же темы есть в меню на консоли сервера — на случай, когда панель не открывается:
    <code>sudo vpn-panel</code>, пункт «Помощь».</p>
</nav>
</div>

<div class="col">
{{ range .topics }}
<section class="card help-topic" id="{{ .Key }}" data-pick-panel>
    <h2>{{ .Question }}</h2>
    {{ if .Checks.Lines }}
    <h3 class="caps-label">Проверено сейчас</h3>
    {{ template "components/status-grid" .Checks }}
    {{ end }}
    <h3 class="caps-label">Что делать</h3>
    <ol class="flow">
        {{ range .Steps }}<li class="flow-step"><p class="help-step">{{ . }}</p></li>{{ end }}
    </ol>
    {{ if .Means }}
    <h3 class="caps-label">Здесь поможет</h3>
    <div class="hero-tags">{{ range .Means }}{{ if .URL }}<a class="tag tag-link" href="{{ .URL }}">{{ .Text }}</a>{{ else }}<span class="tag">{{ .Text }} — {{ .Note }}</span>{{ end }}{{ end }}</div>
    {{ end }}
</section>
{{ end }}
</div>
</div>

{{ template "app-bottom" . }}
{{ end }}

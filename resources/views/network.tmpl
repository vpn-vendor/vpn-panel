{{ define "network.tmpl" }}
{{ template "app-top" . }}

{{ if .error }}<div class="alert alert-error">{{ .error }}</div>{{ end }}
{{ if .ok }}<div class="alert alert-code">{{ .ok }}</div>{{ end }}

{{ if .agentDown }}
<div class="alert alert-error">
    <strong>Системная служба недоступна.</strong>
    Данные о сети получить не удалось. Если это повторяется —
    перезагрузите сервер или обратитесь в поддержку.
</div>
{{ else if .methodError }}
<div class="alert alert-error">
    <strong>Не удалось прочитать состояние сети.</strong>
    {{ .methodError }}
</div>
{{ else }}

<div class="card">
    <h2>Роли сетевых карт</h2>
    <p class="muted">Назначьте, какая карта смотрит в интернет, а какая — в
    локальную сеть офиса. Изменения безопасны: если связь с панелью
    прервётся, всё автоматически вернётся как было.</p>
    <form method="post" action="/network/apply">
        <input type="hidden" name="_csrf" value="{{ .csrf }}">
        <table>
            <thead>
                <tr><th>Карта</th><th>MAC</th><th>Состояние</th><th>Текущие адреса</th><th>Роль</th><th>Адрес в локальной сети</th></tr>
            </thead>
            <tbody>
                {{ range .ifaces }}
                <tr data-iface="{{ .Name }}">
                    <td><code>{{ .Name }}</code></td>
                    <td><code>{{ .MAC }}</code></td>
                    <td>{{ if eq .State "UP" }}<span class="state-up">работает</span>{{ else if eq .State "DOWN" }}<span class="state-down">выключен</span>{{ else }}{{ .State }}{{ end }}</td>
                    <td>{{ range .Addresses }}<code>{{ . }}</code> {{ else }}—{{ end }}</td>
                    <td>
                        <select name="role_{{ .Name }}" class="js-role" data-iface="{{ .Name }}">
                            <option value="unused" {{ if eq .Role "unused" }}selected{{ end }}>не используется</option>
                            <option value="wan" {{ if eq .Role "wan" }}selected{{ end }}>интернет (WAN)</option>
                            <option value="lan" {{ if eq .Role "lan" }}selected{{ end }}>локальная сеть (LAN)</option>
                        </select>
                    </td>
                    <td>
                        <input class="js-lan-cidr" name="cidr_{{ .Name }}" value="{{ .CIDR }}" placeholder="192.168.11.1/24" {{ if ne .Role "lan" }}hidden{{ end }}>
                        <span class="muted js-wan-note" {{ if ne .Role "wan" }}hidden{{ end }}>интернет-подключение — в блоке ниже</span>
                    </td>
                </tr>
                {{ end }}
            </tbody>
        </table>

        {{ if .wan }}
        <div class="wan-config" data-wan-iface="{{ .wan.Name }}">
            <h3>Подключение к интернету — карта <code>{{ .wan.Name }}</code></h3>
            <label>Тег VLAN <span class="muted">(только если провайдер его требует)</span>
                <input class="js-vlan" name="vlan_{{ .wan.Name }}" value="{{ .wan.VLAN }}" placeholder="например 100" inputmode="numeric" autocomplete="off">
                <span class="muted js-vlan-hint">{{ if .wan.VLANIface }}Будет создано подключение <code>{{ .wan.VLANIface }}</code>.{{ else }}Оставьте пустым, если провайдер про VLAN ничего не писал.{{ end }}</span></label>
            <label>Как ваш провайдер даёт адрес?
                <select name="wanmethod_{{ .wan.Name }}" class="js-wanmethod">
                    <option value="dhcp" {{ if eq .wan.WANMethod "dhcp" }}selected{{ end }}>Автоматически — провайдер выдаёт адрес сам (DHCP)</option>
                    <option value="static" {{ if eq .wan.WANMethod "static" }}selected{{ end }}>Статический адрес — провайдер дал фиксированные настройки</option>
                    <option value="pppoe" {{ if eq .wan.WANMethod "pppoe" }}selected{{ end }}>По логину и паролю (PPPoE) — провайдер дал имя пользователя</option>
                </select>
            </label>
            <div class="js-static-fields static-fields" {{ if ne .wan.WANMethod "static" }}hidden{{ end }}>
                <p class="muted">Впишите то, что дал провайдер. Маску можно указать прямо в адресе (например <code>203.0.113.45/24</code>) — тогда поле «Маска» заполнять не нужно.</p>
                <div class="field-grid">
                    <label>IP-адрес
                        <input class="js-ip" name="cidr_{{ .wan.Name }}" value="{{ if eq .wan.WANMethod "static" }}{{ .wan.CIDR }}{{ end }}" placeholder="203.0.113.45" autocomplete="off"></label>
                    <label>Маска подсети
                        <input class="js-mask" placeholder="255.255.255.0 или /24" autocomplete="off">
                        <span class="muted js-mask-hint"></span></label>
                    <label>Шлюз <span class="muted">(адрес роутера провайдера)</span>
                        <input class="js-gw" name="gateway_{{ .wan.Name }}" value="{{ .wan.Gateway }}" placeholder="203.0.113.1" autocomplete="off"></label>
                    <label>Серверы имён <span class="muted">(необязательно)</span>
                        <input name="dns_{{ .wan.Name }}" value="{{ .wan.DNS }}" placeholder="9.9.9.9, 149.112.112.112" autocomplete="off"></label>
                </div>
                <p class="alert alert-warn js-gw-warn" hidden></p>
                <p class="muted">Не уверены в маске? Впишите адрес и шлюз — панель подскажет подходящую. Панель всегда советует, но применяет то, что выбрали вы.</p>
            </div>
            <div class="js-pppoe-fields static-fields" {{ if ne .wan.WANMethod "pppoe" }}hidden{{ end }}>
                <p class="muted">Впишите имя пользователя и пароль из договора с провайдером. Адрес выдаст сам провайдер, когда подключение поднимется.</p>
                <div class="field-grid">
                    <label>Имя пользователя
                        <input name="pppoeuser_{{ .wan.Name }}" value="{{ .wan.PPPoEUser }}" placeholder="user@provider" autocomplete="off"></label>
                    <label>Пароль
                        <input type="password" name="pppoepass_{{ .wan.Name }}" placeholder="{{ if .wan.PPPoESaved }}пароль сохранён{{ else }}пароль от провайдера{{ end }}" autocomplete="new-password">
                        {{ if .wan.PPPoESaved }}<span class="muted">Оставьте пустым, чтобы не менять сохранённый пароль.</span>{{ end }}</label>
                </div>
                <p class="muted">Подключение занимает до минуты: панель дождётся ответа провайдера и скажет, если логин или пароль не подошли. Пароль хранится только на сервере и на странице не показывается.</p>
            </div>
        </div>
        {{ end }}

        <div class="alert alert-warn">
            <strong>Применение изменит работу локальной сети.</strong>
            Текущие разговоры и подключения сотрудников прервутся.
            Рекомендуем применять изменения в нерабочее время.
        </div>
        <button type="submit" class="btn">Применить настройки сети</button>
    </form>
    <p class="muted">При назначенных ролях интернет и адреса выдаются устройствам
    офиса автоматически — вручную на компьютерах ничего настраивать не нужно.
    Адреса карт с ролями задаёт панель: если изменить их в настройках сети на
    самом сервере, при следующем применении панель вернёт свои значения.</p>
</div>

<div class="card">
    <h2>Шлюз по умолчанию</h2>
    {{ if .routes }}
    <table>
        <thead>
            <tr><th>Через</th><th>Интерфейс</th><th>Метрика</th></tr>
        </thead>
        <tbody>
            {{ range .routes }}
            <tr>
                <td><code>{{ .Via }}</code></td>
                <td><code>{{ .Dev }}</code></td>
                <td>{{ if .Metric }}{{ .Metric }}{{ else }}—{{ end }}</td>
            </tr>
            {{ end }}
        </tbody>
    </table>
    {{ else }}
    <div class="alert alert-warn">Маршрут по умолчанию не настроен — выхода в интернет нет.</div>
    {{ end }}
</div>

{{ end }}
<script src="{{ .static }}/js/network.js" defer></script>
{{ template "app-bottom" . }}
{{ end }}

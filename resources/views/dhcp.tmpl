{{ define "dhcp.tmpl" }}
{{ template "app-top" . }}

{{ if .error }}<div class="alert alert-error">{{ .error }}</div>{{ end }}
{{ if .ok }}<div class="alert alert-code">{{ .ok }}</div>{{ end }}

{{ if .pools }}{{ template "components/item-grid" .poolCards }}{{ end }}

<div class="cols cols-main">
<div class="col">
<section class="card">
    <div class="card-head">
        <div>
            <h2>Устройства в локальной сети {{ if .rows }}<span class="tag">{{ len .rows }}</span>{{ end }}</h2>
            <p class="muted card-sub">Кто какой адрес получил. Закрепить адрес — одна кнопка в строке:
            устройство будет получать его всегда. Адрес выдаётся на {{ .leaseTime }} суток.</p>
        </div>
    </div>
    {{ if .rows }}
    <div class="list-tools" hidden>
        <label class="visually-hidden" for="dhcp-search">Найти устройство</label>
        <input type="search" id="dhcp-search" data-search-for="dhcp-rows" placeholder="Имя, адрес или аппаратный адрес" autocomplete="off">
        {{ template "components/timeline-filters" .rowFilters }}
    </div>
    <table>
        <thead><tr><th>Устройство</th><th>Адрес</th><th>Аппаратный адрес</th><th>Действует до</th><th>Состояние</th><th><span class="visually-hidden">Закрепление</span></th></tr></thead>
        <tbody id="dhcp-rows">
            {{ range .rows }}
            <tr data-kind="{{ .Kind }}">
                <td>{{ if .Label }}<strong>{{ .Label }}</strong>{{ else }}<span class="muted">имя не сообщило</span>{{ end }}</td>
                <td><code>{{ .IP }}</code></td>
                <td><code>{{ .MAC }}</code></td>
                <td>{{ if .HasLease }}{{ .Until }}{{ else }}<span class="muted">—</span>{{ end }}</td>
                <td>
                    {{ if .Stale }}<span class="tag tag-error">не подходит настройкам сети</span>
                    {{ else if .Waiting }}<span class="tag tag-warn">ожидает применения</span>
                    {{ else if .Pinned }}<span class="tag tag-main">адрес закреплён</span>
                    {{ else }}<span class="tag tag-ok">действует</span>{{ end }}
                </td>
                <td>
                    {{ if .Pinned }}
                    <form method="post" action="/dhcp/unreserve" class="inline-form">
                        <input type="hidden" name="_csrf" value="{{ $.csrf }}">
                        <input type="hidden" name="id" value="{{ .ResID }}">
                        <button type="submit" class="btn btn-ghost btn-small pin pin-on" title="Снять закрепление">{{ template "components/icon" "pin" }}<span class="visually-hidden">Снять закрепление</span></button>
                    </form>
                    {{ else }}
                    <form method="post" action="/dhcp/reserve" class="inline-form">
                        <input type="hidden" name="_csrf" value="{{ $.csrf }}">
                        <input type="hidden" name="mac" value="{{ .MAC }}">
                        <input type="hidden" name="label" value="{{ if .Label }}{{ .Label }}{{ else }}Устройство{{ end }}">
                        <button type="submit" class="btn btn-secondary btn-small pin" title="Закрепить адрес">{{ template "components/icon" "pin" }}<span class="visually-hidden">Закрепить адрес</span></button>
                    </form>
                    {{ end }}
                </td>
            </tr>
            {{ end }}
        </tbody>
    </table>
    {{ else if .pools }}
    <p class="muted">Пока ни одно устройство не получило адрес. Проверьте, что кабель
    локальной сети подключён, а на устройствах включено автоматическое получение адреса.</p>
    {{ end }}
</section>
</div>
<div class="col">
{{ if .suggestIP }}
<section class="card" id="dhcp-reserve">
    <div class="card-head">
        <div>
            <h2>Закрепить адрес вручную</h2>
            <p class="muted card-sub">Для устройства, которого ещё нет в сети: принтер привезут завтра,
            а адрес нужен уже сегодня. Свободный адрес сегмента подставлен.</p>
        </div>
    </div>
    <form method="post" action="/dhcp/reserve">
        <input type="hidden" name="_csrf" value="{{ .csrf }}">
        <label>Устройство
            <input name="label" placeholder="Принтер бухгалтерии" maxlength="50" required>
        </label>
        <label>Аппаратный адрес (MAC)
            <input name="mac" placeholder="a4:bb:6d:1f:22:90" required>
        </label>
        <label>Адрес, который закрепить
            <input name="ip" value="{{ .suggestIP }}" required>
        </label>
        <div class="btn-row"><button type="submit" class="btn">Закрепить адрес</button></div>
    </form>
</section>
{{ end }}

{{ if .pools }}
<section class="card">
    <div class="card-head">
        <div>
            <h2>Как это работает</h2>
        </div>
    </div>
    <div class="setting setting-wide">
        <div>
            <div class="setting-title">Зачем закреплять адрес</div>
            <p class="setting-text">Устройствам, чей адрес не должен меняться: локальной АТС, принтерам,
            камерам, настольным телефонам. Остальные получают адрес сами и держат его {{ .leaseTime }} суток.</p>
        </div>
    </div>
    <div class="setting setting-wide">
        <div>
            <div class="setting-title">Когда закрепление вступает в силу</div>
            <p class="setting-text">Сразу после нажатия служба выдачи адресов перечитывает настройки.
            Устройство получит адрес при следующем обновлении аренды или после переподключения к сети —
            до этого строка помечена «ожидает применения».</p>
        </div>
    </div>
    <div class="setting setting-wide">
        <div>
            <div class="setting-title">Если адреса кончаются</div>
            <p class="setting-text">Жёлтая метка у сегмента значит, что свободных адресов меньше пятой части.
            Новые устройства могут не получить адрес: уберите лишние устройства из сети или расширьте
            сегмент на странице «Сеть».</p>
        </div>
    </div>
</section>
{{ end }}
</div>
</div>

{{ template "app-bottom" . }}
{{ end }}

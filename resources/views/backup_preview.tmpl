{{ define "backup_preview.tmpl" }}
{{ template "app-top" . }}

{{ if .error }}<div class="alert alert-error" role="alert">{{ .error }}</div>{{ end }}

<section class="card">
    <div class="card-head">
        <div>
            <h2>Что изменится</h2>
            <p class="muted card-sub">Файл <strong>{{ .fileName }}</strong>.
            {{ if .isCopy }}Своя копия: разделы из файла заменят текущие целиком.{{ else }}Шаблон: меняются только правила офиса, карты и адреса этого шлюза остаются.{{ end }}
            Подсвечены разделы, которые изменятся.</p>
        </div>
        {{ if .isCopy }}<span class="tag tag-ok">копия</span>{{ else }}<span class="tag">шаблон</span>{{ end }}
    </div>
    <table>
        <thead><tr><th>Раздел</th><th>Что будет</th></tr></thead>
        <tbody>
            {{ range .sections }}
            <tr{{ if .Changed }} class="row-changed"{{ else if .Absent }} class="row-absent"{{ end }}>
                <td>{{ .Title }}</td>
                <td>{{ .State }}{{ range .Items }}<br>{{ . }}{{ end }}</td>
            </tr>
            {{ end }}
        </tbody>
    </table>
</section>

{{ if .cards }}
<section class="card">
    <div class="card-head">
        <div>
            <h2>Сетевые карты этого шлюза</h2>
            <p class="muted card-sub">Файл сделан на другом железе. Скажите, какая карта этого шлюза берёт
            роль каждой карты из файла. Подсказки — что панель видит на картах прямо сейчас.</p>
        </div>
    </div>
    <table>
        <thead><tr><th>Карта</th><th>MAC</th><th>Что видно</th></tr></thead>
        <tbody>
            {{ range .cardFacts }}<tr><td>{{ .Name }}</td><td><code>{{ .MAC }}</code></td><td>{{ .Facts }}</td></tr>{{ end }}
        </tbody>
    </table>
    <form method="post" action="/backup/import/cards">
        <input type="hidden" name="_csrf" value="{{ .csrf }}">
        {{ range .cards }}
        <div class="setting">
            <div>
                <div class="setting-title">В файле эта карта {{ .Role }}</div>
                <p class="setting-text">Выберите карту этого шлюза, которая возьмёт её роль.</p>
            </div>
            <div class="setting-ctl">{{ template "components/select" .Select }}</div>
        </div>
        {{ end }}
        <div class="btn-row">{{ template "components/button" .cardBtn }}</div>
    </form>
</section>
{{ end }}

{{ range .hints }}<div class="alert alert-warn">{{ . }}</div>{{ end }}
{{ range .errors }}<div class="alert alert-error">{{ . }}</div>{{ end }}

{{ if .ready }}
<form method="post" action="/backup/import/apply">
    <input type="hidden" name="_csrf" value="{{ .csrf }}">
    {{ if .danger }}
    {{ template "components/danger-confirm" .danger }}
    {{ else }}
    <section class="card">
        <div class="card-head">
            <div>
                <h2>Применить</h2>
                <p class="muted card-sub">После применения у вас будет время проверить работу и закрепить
                настройки. Без решения в срок, как и при выключении света, они вернутся к прежним сами.</p>
            </div>
        </div>
        <div class="btn-row">{{ template "components/button" .applyBtn }}</div>
    </section>
    {{ end }}
</form>
{{ end }}

<form method="post" action="/backup/import/discard" class="btn-row">
    <input type="hidden" name="_csrf" value="{{ .csrf }}">
    {{ template "components/button" .dropBtn }}
</form>

<script src="{{ .static }}/js/backup.js" defer></script>

{{ template "app-bottom" . }}
{{ end }}

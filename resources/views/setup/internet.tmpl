{{ define "setup/internet" }}
{{ template "wizard-top" . }}
{{ template "components/facts" .facts }}
<form method="post" action="/setup/internet/recheck" id="recheck-form" hidden>
    <input type="hidden" name="_csrf" value="{{ .csrf }}">
</form>
<form method="post" action="/setup/answer" id="skip-form" hidden>
    <input type="hidden" name="_csrf" value="{{ .csrf }}">
    <input type="hidden" name="step" value="internet">
    <input type="hidden" name="action" value="skip">
</form>
{{ template "wizard-bottom" . }}
{{ end }}

{{ define "setup/speed" }}
{{ template "wizard-top" . }}
{{ template "speedtest-card" . }}
<form method="post" action="/setup/speed" id="step-form">
    <input type="hidden" name="_csrf" value="{{ .csrf }}">
    <div class="field-grid">
        {{ template "components/field" .downField }}
        {{ template "components/field" .upField }}
    </div>
    <p class="muted">В договоре обычно одна цифра — это скачивание; отдача
    почти всегда ниже. Замер выше покажет обе настоящие скорости.</p>
</form>
<form method="post" action="/setup/answer" id="skip-form" hidden>
    <input type="hidden" name="_csrf" value="{{ .csrf }}">
    <input type="hidden" name="step" value="speed">
    <input type="hidden" name="action" value="skip">
</form>
<script src="{{ .static }}/js/qos.js" defer></script>
{{ template "wizard-bottom" . }}
{{ end }}

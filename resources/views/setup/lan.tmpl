{{ define "setup/lan" }}
{{ template "wizard-top" . }}
<form method="post" action="/setup/answer" id="step-form">
    <input type="hidden" name="_csrf" value="{{ .csrf }}">
    <input type="hidden" name="step" value="lan">
    <input type="hidden" name="action" value="choose">
    {{ template "components/choice" .choice }}
    <p class="muted">Остальные карты останутся без роли — их можно назначить
    позже на странице «Сеть».</p>
</form>
{{ template "wizard-bottom" . }}
{{ end }}

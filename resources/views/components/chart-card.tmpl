{{ define "components/chart-card" }}
{{ if .Stub }}
<section class="chart-card chart-stub" id="{{ .ID }}" data-kind="{{ .KindName }}">
    <header class="chart-head">
        <h3 class="chart-title">{{ .Title }}<span class="tag tag-dev">в разработке</span></h3>
    </header>
    <p class="chart-note">{{ .Stub }}</p>
</section>
{{ else }}
<section class="chart-card" id="{{ .ID }}" data-island="chart" data-kind="{{ .KindName }}" data-rows="{{ .RowNames }}" data-window="{{ .WindowName }}" data-unit="{{ .UnitName }}"{{ if .Norm }} data-norm="{{ .Norm }}"{{ end }}{{ with .Scale }} data-warn="{{ .Warn }}" data-bad="{{ .Bad }}"{{ end }}{{ with .SpanAttr }} data-span="{{ . }}"{{ end }}{{ if .Follow }} data-follow="window"{{ end }}
         data-text-paused="Сбор показателей остановлен на странице «Защита»." data-text-busy="Сервер занят, график обновится позже." data-text-empty="Данных за это время пока нет." data-text-min="мин" data-text-max="макс">
    <header class="chart-head">
        <div class="chart-head-words">
            <h3 class="chart-title">{{ .Title }}<span class="chart-zoom" data-chart-zoom aria-hidden="true" hidden>{{ template "components/icon" "search" }}</span></h3>
            {{ if .Sub }}<p class="chart-sub">{{ .Sub }}</p>{{ end }}
        </div>
        {{ with .Tag }}<span class="{{ .Class }}">{{ .Text }}</span>{{ end }}
        {{ with .Chips }}{{ template "components/window-chips" . }}{{ end }}
    </header>
    <div class="chart-values">
        {{ range .ShownRows }}
        <div class="chart-value {{ .SeriesClass }} tone-{{ .ToneName }}" data-row="{{ .Name }}" data-label="{{ .Label }}" data-tone="{{ .ToneName }}">
            <span class="chart-dot" aria-hidden="true"></span>
            <span class="chart-label">{{ .Label }}</span>
            <span class="chart-num" data-row-value>{{ .Shown }}</span>
        </div>
        {{ end }}
        <span class="chart-mm" data-chart-mm></span>
    </div>
    <div class="chart-plot"><canvas class="chart-canvas" aria-hidden="true"></canvas></div>
    <p class="chart-note" data-chart-note>{{ .Note }}</p>
</section>
{{ end }}
{{ end }}

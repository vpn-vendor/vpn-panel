{{ define "components/link-card" }}
<section class="card link-card">
    <h2 class="link-card-title">
        <a href="{{ .URL }}">{{ .Title }}{{ with .Tag }}<span class="{{ .Class }}">{{ .Text }}</span>{{ end }}<span class="link-card-go" aria-hidden="true">{{ template "components/icon" "chevron" }}</span></a>
    </h2>
    {{ with .Mark }}<div class="link-card-mark"><span class="{{ .Class }}" aria-hidden="true">{{ .Mono }}</span><span class="link-card-proto">{{ .Label }}</span></div>{{ end }}
    {{ template "components/metric-grid" . }}
    {{ if .Note }}<p class="muted">{{ .Note }}</p>{{ end }}
    {{ with .Stub }}<p class="link-card-stub">{{ . }}<span class="tag tag-dev">в разработке</span></p>{{ end }}
</section>
{{ end }}

{{ define "components/chart-panel" }}
<dialog class="chart-panel" data-island="chart-panel" aria-labelledby="chart-panel-title">
    <header class="chart-panel-head">
        <div class="chart-panel-titles">
            <h2 class="chart-panel-title" id="chart-panel-title" data-panel-title></h2>
            <p class="chart-panel-sub" data-panel-sub></p>
        </div>
        <button type="button" class="btn btn-secondary btn-small" data-panel-reset hidden>Весь отрезок</button>
        <button type="button" class="chrome-btn chart-panel-close" data-panel-close aria-label="Закрыть" title="Закрыть">{{ template "components/icon" "close" }}</button>
    </header>
    {{ template "components/window-chips" .Chips }}
    <div class="chart-panel-values" data-panel-values></div>
    
    <p class="chart-panel-read" data-panel-read aria-live="polite"></p>
    <div class="chart-panel-plot">
        <canvas class="chart-canvas chart-panel-canvas" aria-hidden="true"></canvas>
        <div class="chart-select" data-chart-select hidden></div>
        
        <div class="chart-cross" data-chart-cross hidden>
            <span class="chart-cross-dot" data-cross="0"></span>
            <span class="chart-cross-dot" data-cross="1"></span>
        </div>
    
    <div class="chart-coach" data-panel-coach role="status" hidden>
        <p class="chart-coach-text">Коснитесь графика и ведите палец — панель покажет значение в этой точке. На компьютере то же делает мышь.</p>
        <button type="button" class="btn btn-small" data-coach-ok>Понятно</button>
    </div>
    </div>
    <p class="chart-panel-note" data-panel-note>Коснитесь графика, чтобы увидеть значение в точке.</p>

</dialog>
{{ end }}

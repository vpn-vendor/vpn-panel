{{ define "components/gauge" }}
<section class="{{ .Class }}" id="{{ .ID }}"{{ if .Row }} data-island="chart" data-kind="gauge" data-rows="{{ .Row }}{{ with .Row2 }},{{ . }}{{ end }}{{ range .Legend }}{{ with .Row }},{{ . }}{{ end }}{{ end }}" data-gauge-row="{{ .Row }}"{{ with .Row2 }} data-gauge-row2="{{ . }}"{{ end }} data-unit="{{ .Unit }}" data-max="{{ .MaxAttr }}"{{ with .Num .Warn }} data-warn="{{ . }}"{{ end }}{{ with .Num .Bad }} data-bad="{{ . }}"{{ end }}{{ end }}>
    <svg class="gauge-ring" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
        <circle class="gauge-track" cx="48" cy="48" r="40" stroke-width="10" pathLength="100"/>
        {{ if .Row2 }}<circle class="gauge-arc gauge-arc-2" cx="48" cy="48" r="40" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray="{{ .Dash2 }}" transform="rotate(-90 48 48)" data-gauge-arc2/>{{ end }}
        <circle class="gauge-arc" cx="48" cy="48" r="40" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray="{{ .Dash }}" transform="rotate(-90 48 48)" data-gauge-arc/>
    </svg>
    <div class="gauge-words">
        <h3 class="gauge-title">{{ .Title }}</h3>
        <div class="gauge-value num" data-gauge-value>{{ .Shown }}</div>
        <p class="gauge-note">{{ if .Known }}{{ .Note }}{{ else }}{{ .Empty }}{{ end }}</p>
        {{ if .Legend }}
        <ul class="gauge-legend">
            {{ range .Legend }}<li class="{{ .Tone.Class }}{{ if .Faint }} gauge-faint{{ end }}"{{ with .Row }} data-legend-row="{{ . }}" data-unit="{{ $.Unit }}"{{ end }}><span class="gauge-key" aria-hidden="true"></span>{{ .Label }} <span data-row-value>{{ .Value }}</span></li>{{ end }}
        </ul>
        {{ end }}
    </div>
</section>
{{ end }}

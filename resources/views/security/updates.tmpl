{{ define "security/updates" }}
{{ if or .updatesKnown .releaseKnown }}
<section class="card">
    <div class="card-head">
        <div>
            <h2>Обновления панели</h2>
            <p class="muted card-sub">{{ if .panelVersion }}Сейчас версия {{ .panelVersion }}. {{ end }}Обновляется только панель:
            системные пакеты, ядро и сеть не трогаются, сервер сам не перезагружается.</p>
        </div>
    </div>

    {{ if .updatesKnown }}
    
    <form method="post" action="/security/updates" data-autosubmit
          data-question="Включить автоматические обновления панели? Панель будет обновляться сама, во время установки админка будет недоступна около минуты. Интернет офиса и разговоры не прервутся.">
        <input type="hidden" name="_csrf" value="{{ .csrf }}">
        {{ template "components/switch-row" .switchUpdates }}
        {{ if .updatesTool }}<div class="btn-row" data-nojs><button type="submit" class="btn btn-secondary btn-small">Применить</button></div>{{ end }}
    </form>
    {{ end }}

    {{ if .releaseKnown }}
    <div class="setting">
        <div>
            <div class="setting-title">После обновления
                {{ if eq .releasePhase "observing" }}<span class="tag tag-warn">идёт проверка</span>
                {{ else if eq .releasePhase "await" }}<span class="tag tag-warn">замечена неполадка</span>
                {{ else if eq .releasePhase "rollback_pending" }}<span class="tag tag-warn">возврат на прежнюю</span>
                {{ else if eq .releasePhase "rolled_back" }}<span class="tag tag-ok">вернулась на прежнюю</span>
                {{ else if eq .releasePhase "limp" }}<span class="tag tag-error">нужна ручная проверка</span>{{ end }}
            </div>
            <p class="setting-text">
            {{ if eq .releasePhase "observing" }}Панель недавно обновилась. Идёт проверка новой версии — если что-то
            пойдёт не так, она вернётся на прежнюю сама.
            {{ else if eq .releasePhase "await" }}После обновления замечена неполадка. Можно оставить новую версию
            или дождаться, пока панель вернётся на прежнюю.
            {{ else if eq .releasePhase "rollback_pending" }}Новая версия не прошла проверку — панель
            возвращается на прежнюю{{ if .releaseAnchor }} ({{ .releaseAnchor }}){{ end }}.
            {{ else if eq .releasePhase "rolled_back" }}Панель вернулась на прежнюю версию{{ if .releaseAnchor }}
            ({{ .releaseAnchor }}){{ end }} — новая дала сбой. Настройки, сделанные за
            последние минуты до отката, могли не сохраниться.
            {{ else if eq .releasePhase "limp" }}Ни новая, ни прежняя версия не работают как
            надо. Панель остановила автоматические действия и ждёт ручной проверки —
            обратитесь в поддержку.
            {{ end }}
            {{ if .releaseReasons }}Что замечено: {{ range $i, $r := .releaseReasons }}{{ if $i }}; {{ end }}{{ $r }}{{ end }}.{{ end }}
            </p>
        </div>
        {{ if .releaseSettling }}
        <div class="setting-ctl">
            <form method="post" action="/security/release/accept">
                <input type="hidden" name="_csrf" value="{{ .csrf }}">
                <button type="submit" class="btn">Оставить новую версию</button>
            </form>
        </div>
        {{ end }}
    </div>
    {{ end }}
</section>
{{ end }}
{{ end }}

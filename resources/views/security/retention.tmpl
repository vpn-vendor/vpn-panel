{{ define "security/retention" }}

<form method="post" action="/security/retention" data-unsaved>
    <input type="hidden" name="_csrf" value="{{ .csrf }}">
    {{ range .retentionRows }}
    <div class="setting">
        <div>
            <label class="setting-title" for="{{ .ID }}">{{ .Label }}</label>
            <p class="setting-text" id="{{ .ID }}-hint">{{ .Hint }}</p>
        </div>
        <div class="setting-ctl">
            <input class="field-input input-days" id="{{ .ID }}" name="{{ .Name }}" type="number" value="{{ .Value }}"
                   min="{{ .Min }}" max="{{ .Max }}" aria-describedby="{{ .ID }}-hint" required>
            <span class="muted">дней</span>
        </div>
    </div>
    {{ end }}
    <div class="btn-row">{{ template "components/button" .buttonRetention }}</div>
</form>
{{ end }}

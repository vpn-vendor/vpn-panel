{{ define "speedtest-card" }}
<section class="card" id="speedtest">
    <div class="card-head">
        <div>
            <h2>Замер скорости{{ if .measureWhen }} <span class="tag">{{ .measureWhen }}</span>{{ end }}</h2>
            <p class="muted card-sub">Меряется канал <strong>самого сервера</strong>, а не вашего компьютера. Итог — медиана
            по нескольким независимым источникам.</p>
        </div>
    </div>

    {{ if .measuring }}
    <div class="alert alert-warn" data-speedtest-running>Идёт замер — страница обновится сама. Если этого не произошло
    за минуту, обновите её вручную.</div>
    {{ else }}

    {{ if .measureError }}
    <div class="alert alert-error">Замер не удался: {{ .measureError }} Введите скорости из договора с провайдером.</div>
    {{ end }}

    {{ template "components/metric-grid" .measureMetrics }}
    {{ if .measureDone }}
    {{ if .measureDivergent }}
    <p class="muted">Источники заметно расходятся — итог взят как медиана. Повторите замер в другое время; если
    расхождение сохраняется, укажите значение из договора с провайдером.</p>
    {{ end }}
    <details class="fold">
        <summary>{{ template "components/icon" "chevron" }}Источники замера</summary>
        <div class="fold-body">
            {{ range .measureSources }}<div class="setting setting-pair"><div><div class="setting-title">{{ .Name }}</div></div><div class="setting-ctl"><span class="tag mono">{{ .Speed }}</span></div></div>{{ end }}
        </div>
    </details>
    {{ if .measureDev }}
    <div class="alert alert-warn">Среда разработки: цифры относятся к контейнеру, а не к серверу, — подставлять их в тариф нельзя.</div>
    {{ end }}
    {{ end }}

    <form method="post" action="/qos/speedtest" class="btn-row">
        <input type="hidden" name="_csrf" value="{{ .csrf }}">
        <input type="hidden" name="back" value="{{ .speedBack }}">
        {{ if .measureDone }}{{ if not .measureDev }}
        <a href="#qos-down" class="btn btn-secondary" data-fill-tariff
           data-down="{{ .measureDownMbit }}" data-up="{{ .measureUpMbit }}">Подставить в поля тарифа</a>
        {{ end }}{{ end }}
        <button type="submit" class="btn">Запустить замер</button>
    </form>
    <p class="muted">До 30 секунд, несколько сотен мегабайт. На время замера защита звонков снимается, а канал занят —
    запускайте в спокойную минуту.</p>
    {{ end }}
</section>
{{ end }}

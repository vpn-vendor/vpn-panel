{{ define "vpn.tmpl" }}
{{ template "app-top" . }}

{{ if .error }}<div class="alert alert-error">{{ .error }}</div>{{ end }}
{{ if .ok }}<div class="alert alert-code">{{ .ok }}</div>{{ end }}

{{ if .intentBroken }}
<div class="alert alert-error">
    <strong>Настройки защищённого канала повреждены.</strong>
    Сохранённый режим перестал читаться (сбой диска или питания). Чтобы трафик
    офиса не пошёл мимо канала, офис закрыт от интернета или будет закрыт после
    перезагрузки. Проверьте режим и подключение ниже и нажмите «Применить» —
    настройки запишутся заново, и офис вернётся в выбранный режим.
</div>
{{ end }}

{{ if .agentDown }}
<div class="alert alert-error">
    <strong>Системная служба недоступна.</strong>
    Состояние защищённого канала получить не удалось. Если это повторяется —
    перезагрузите сервер или обратитесь в поддержку.
</div>
{{ end }}

<section class="card vpn-scene"{{ if .checkRunning }} data-vpncheck-running="1"{{ end }}>
    {{ template "components/hero-status" .scene.Hero }}
    {{ template "components/traffic-path" .scene.Path }}
    {{ template "components/metric-grid" .scene.Metrics }}
    <div class="hero-actions">
        {{ if and .tunnelUp (eq .scene.Kind "up") }}
        {{ if .checkRunning }}
        <span class="tag tag-warn">идёт проверка — страница обновится сама</span>
        {{ else }}
        <form method="post" action="/vpn/check" class="inline-form">
            <input type="hidden" name="_csrf" value="{{ .csrf }}">
            <input type="hidden" name="mode" value="quick">
            <button type="submit" class="btn btn-secondary">Быстрая проверка</button>
        </form>
        <form method="post" action="/vpn/check" class="inline-form">
            <input type="hidden" name="_csrf" value="{{ .csrf }}">
            <input type="hidden" name="mode" value="full">
            <button type="submit" class="btn btn-secondary">Полная проверка со скоростью</button>
        </form>
        <form method="post" action="/vpn/check" class="inline-form" data-direct-form>
            <input type="hidden" name="_csrf" value="{{ .csrf }}">
            <input type="hidden" name="mode" value="full">
            <input type="hidden" name="direct" value="1">
            <button type="button" class="btn btn-ghost" data-direct-open>Скорость без канала</button>
        </form>
        {{ end }}
        {{ else if eq .scene.Kind "down" }}
        {{ with .reconnect }}{{ template "components/action-form" . }}{{ end }}
        {{ if .reconnectWait }}<button type="button" class="btn" disabled>{{ template "components/icon" "refresh" }}Переподключить сейчас</button>{{ end }}
        <a class="btn btn-ghost" href="#vpn-modes">Изменить поведение при обрыве</a>
        {{ end }}
    </div>
    {{ if and .tunnelUp (eq .scene.Kind "up") }}{{ if not .checkRunning }}<p class="muted">Быстрая проверка — около полминуты, разговорам не мешает. Полная скачивает файлы через канал: на время закачки разговоры могут стать хуже.</p>{{ end }}{{ end }}
    {{ if .checkError }}<p class="muted">Проверка не выполнена: {{ .checkError }}</p>{{ end }}
    {{ if eq .scene.Kind "down" }}<p class="muted">{{ if .reconnectWait }}Попытка уже была. Снова вручную — через {{ .reconnectWait }}; панель тем временем пробует сама.{{ else }}Одна попытка вне очереди. Не чаще раза в минуту: так сервер поставщика не примет попытки за атаку.{{ end }}</p>{{ end }}

    <dialog id="direct-dialog" class="confirm-dialog">
        <h3>Сервер выйдет в интернет мимо защищённого канала</h3>
        <p>Чтобы измерить, сколько даёт ваш провайдер <strong>без канала</strong>,
        сервер один раз обратится к источнику замера <strong>напрямую</strong> —
        своим настоящим адресом, а не адресом сервера подключения.</p>
        <p><strong>Что это значит для анонимности.</strong> Источник замера
        увидит настоящий публичный адрес вашего офиса и факт обращения. Ваш
        провайдер увидит одно зашифрованное соединение к нему. Содержимое и
        адреса сайтов, которые открывают сотрудники, при этом не раскрываются:
        весь остальной трафик офиса продолжает идти через канал.</p>
        <p><strong>Что произойдёт:</strong> одно соединение, около восьми
        секунд, один источник. Событие будет записано в журнал безопасности.</p>
        <p class="muted">Без этого замера сравнивать скорость канала не с чем:
        панель не может отличить «канал медленный» от «у провайдера столько же».</p>
        <div class="dialog-actions">
            <button type="button" class="btn btn-small" data-direct-cancel>Отмена</button>
            <button type="button" class="btn" data-direct-confirm disabled>Подтверждаю (3)</button>
        </div>
    </dialog>
</section>

{{ if .findings }}
<section class="card">
    <div class="card-head">
        <div>
            <h2>Что происходит с каналом</h2>
            <p class="muted card-sub">Панель разбирает состояние сама и отвечает на самые
            частые вопросы. Если ответ вам понятен — обращаться в поддержку не нужно.</p>
        </div>
    </div>
    {{ range .findings }}
    <div class="finding finding-{{ .Level }}">
        <div class="finding-title">{{ .Title }}</div>
        <p>{{ .Text }}</p>
        {{ if .Action }}<p class="finding-action"><strong>Что делать:</strong> {{ .Action }}</p>{{ end }}
    </div>
    {{ end }}
</section>
{{ end }}

{{ with .setup }}{{ template "components/checklist" . }}{{ end }}

<section class="card" id="vpn-profiles">
    <div class="card-head">
        <div>
            <h2>Подключения <span class="tag">{{ len .profiles }}</span></h2>
            <p class="muted card-sub">Файлы от поставщика VPN: панель сама их не создаёт. Работает одно подключение,
            на другое можно переключиться.</p>
        </div>
        {{ if .activeName }}<span class="tag{{ if eq .scene.Kind "up" }} tag-ok{{ end }}">{{ if eq .scene.Kind "up" }}работает{{ else }}выбрано{{ end }}: {{ .activeName }}</span>{{ end }}
    </div>
    {{ template "components/profile-grid" .profileGrid }}
    {{ if .hasProfile }}
    
    <div class="alert alert-warn" data-switch-warn data-form="vpn-apply">
        <div class="alert-row">
            <div>
                <strong>Переключение прервёт текущие разговоры.</strong>
                Канал опустится на несколько секунд и поднимется уже через новый сервер, адрес
                офиса для сайтов сменится. Меняйте в нерабочее время или предупредите сотрудников.
            </div>
            <div class="alert-actions">
                <button type="button" class="btn btn-secondary btn-small" data-switch-cancel>Отмена</button>
                <button type="submit" class="btn btn-small" form="vpn-apply">Переключить</button>
            </div>
        </div>
    </div>
    {{ end }}
    <details class="fold">
        <summary>{{ template "components/icon" "chevron" }}Какие файлы подходят</summary>
        <div class="fold-body">
            <span class="choice-points">
                <span class="pt pt-plus"><span class="pt-sign" aria-hidden="true">+</span><span>{{ range .upload.Kinds }}{{ .Sep }}{{ .Label }} (<code>{{ .Ext }}</code>){{ end }} со всеми ключами и сертификатами внутри файла. Протокол панель узнаёт по содержимому.</span></span>
                <span class="pt pt-note"><span class="pt-sign" aria-hidden="true">·</span><span>Подключение по TCP принимается, но помечается: для разговоров оно не годится.</span></span>
                <span class="pt pt-minus"><span class="pt-sign" aria-hidden="true">−</span><span>Файлы со встроенными командами, с логином и паролем или со сжатием панель не принимает и объясняет почему.</span></span>
                <span class="pt pt-plus"><span class="pt-sign" aria-hidden="true">+</span><span>Секретный ключ и сертификаты остаются на сервере: их не видно ни здесь, ни в резервных копиях.</span></span>
            </span>
        </div>
    </details>
</section>

<div class="cols cols-main vpn-modes" id="vpn-modes">
<div class="col">
<section class="card">
    <div class="card-head">
        <div>
            <h2>Как офис выходит в интернет</h2>
            <p class="muted card-sub">Зелёным отмечен безопасный выбор. Применяется сразу, без перезагрузки.</p>
        </div>
    </div>
    <form method="post" action="/vpn/apply" id="vpn-apply" class="vpn-mode-form" data-unsaved>
        <input type="hidden" name="_csrf" value="{{ .csrf }}">
        {{ template "components/choice-card" .modeCards }}
        <h3 class="caps-label">Если канал пропадёт</h3>
        <p class="muted vpn-fail-note{{ if not .black }} is-current{{ end }}">Действует только в режиме «{{ .tunnelMode }}»: при прямом доступе обрывать нечего.</p>
        <div class="vpn-fail">{{ template "components/choice-card" .failCards }}</div>
        <div class="mode-verdict">
            <div class="vd vd-safe{{ if eq .verdict "safe" }} is-current{{ end }}"><span class="vd-dot" aria-hidden="true"></span><div><div class="vd-title">Итог: офис невидим для провайдера всегда</div><p class="vd-text">Через {{ .tunnelWord }}, а при обрыве интернет закрывается: утечек не будет.</p></div></div>
            <div class="vd vd-partial{{ if eq .verdict "partial" }} is-current{{ end }}"><span class="vd-dot" aria-hidden="true"></span><div><div class="vd-title">Итог: защищено, но не при обрыве</div><p class="vd-text">Пока канал работает, офис невидим. Во время обрыва трафик пойдёт напрямую.</p></div></div>
            <div class="vd vd-open{{ if eq .verdict "open" }} is-current{{ end }}"><span class="vd-dot" aria-hidden="true"></span><div><div class="vd-title">Итог: офис виден провайдеру</div><p class="vd-text">Провайдер видит адреса сайтов, сайты видят настоящий адрес офиса.</p></div></div>
            <button type="submit" class="btn">Применить</button>
        </div>
    </form>
    
    <form method="post" action="/vpn/mtu" id="vpn-mtu" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ .csrf }}">
    </form>
    <form method="post" action="/vpn/timesync" id="vpn-timesync" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ .csrf }}">
    </form>
</section>
</div>
<div class="col">
<section class="card">
    <div class="card-head">
        <div>
            <h2>Что видит провайдер</h2>
            <p class="muted card-sub">Два режима рядом. Подсвечен выбранный.</p>
        </div>
    </div>
    <table class="cmp">
        <thead><tr><th><span class="visually-hidden">Что</span></th><th class="c-direct{{ if not .black }} is-current{{ end }}">Напрямую</th><th class="c-tunnel{{ if .black }} is-current{{ end }}">Через {{ .tunnelWord }}</th></tr></thead>
        <tbody>
            <tr><td>Какие сайты открывает офис</td><td class="c-direct{{ if not .black }} is-current{{ end }}"><span class="cmp-no">видит</span></td><td class="c-tunnel{{ if .black }} is-current{{ end }}"><span class="cmp-yes">не видит</span></td></tr>
            <tr><td>Адрес офиса для сайтов</td><td class="c-direct{{ if not .black }} is-current{{ end }}"><span class="cmp-no">настоящий</span></td><td class="c-tunnel{{ if .black }} is-current{{ end }}"><span class="cmp-yes">адрес сервера {{ .tunnelWord }}</span></td></tr>
            <tr><td>С каким сервером телефонии говорит офис</td><td class="c-direct{{ if not .black }} is-current{{ end }}"><span class="cmp-no">видит</span></td><td class="c-tunnel{{ if .black }} is-current{{ end }}"><span class="cmp-yes">не видит</span></td></tr>
            <tr><td>Что офис подключён к {{ .tunnelWord }}</td><td class="c-direct{{ if not .black }} is-current{{ end }}"><span class="muted">—</span></td><td class="c-tunnel{{ if .black }} is-current{{ end }}"><span class="muted">видит, это нормально</span></td></tr>
        </tbody>
    </table>
    <details class="fold">
        <summary>{{ template "components/icon" "chevron" }}Чего канал не скрывает</summary>
        <div class="fold-body">
            <div class="setting setting-wide">
                <div>
                    <div class="setting-title">Приметы браузера</div>
                    <p class="setting-text">Браузер сотрудника сам сообщает сайту часовой пояс системы, язык и другие приметы.
                    Если выход канала в одной стране, а компьютер настроен на другую, внимательный сайт это заметит:
                    шлюз не видит, что браузер пишет о себе внутри защищённого соединения.</p>
                </div>
            </div>
            <div class="setting setting-wide">
                <div>
                    <div class="setting-title">Вход в аккаунты</div>
                    <p class="setting-text">Сайт, где сотрудник вошёл под своим именем, знает его по входу, а не по адресу.</p>
                </div>
            </div>
            <div class="setting setting-wide">
                <div>
                    <div class="setting-title">Часовой пояс компьютеров</div>
                    <p class="setting-text">Менять его мы не советуем, и панель этого не делает: сдвинутый пояс ломает
                    расписания, отчётность, журналы и вход в доменную сеть. Панель следит, чтобы точным было время
                    на сервере — это нужно и каналу, и сертификатам, и журналам.</p>
                </div>
            </div>
        </div>
    </details>
</section>
</div>
</div>

{{ if .tunnelUp }}{{ with .check }}{{ if .Has }}
<section class="card">
    <div class="card-head">
        <div>
            <h2>Качество канала {{ if .Grade.Text }}<span class="{{ .Grade.Class }}">{{ .Grade.Text }}</span>{{ end }}</h2>
            <p class="muted card-sub">Последняя проверка: {{ .When }}, {{ .Mode }}, {{ .TookSec }} с.</p>
        </div>
        {{ if .Past }}<span class="tag tag-warn">снята с другим соединением</span>{{ end }}
    </div>
    {{ if .Past }}<p class="muted">Эта проверка снята до переподключения канала или с другим профилем: к нынешнему соединению она не относится и в разборе выше не учитывается. Запустите проверку заново, чтобы получить свежий результат.</p>{{ end }}
    {{ template "components/metric-grid" .Summary }}
    <details class="fold">
        <summary>{{ template "components/icon" "chevron" }}Подробности проверки</summary>
        <div class="fold-body">
            <p class="muted">Сколько теряют служебные пакеты и настоящие данные, какая задержка до сервера мимо
            канала и внутри него, сколько отбросили очереди самого сервера.</p>
    <table>
        <thead><tr><th>Что измеряли</th><th>Потери</th><th>Задержка</th><th>Джиттер</th><th>Качество разговора</th><th>Достоверность</th></tr></thead>
        <tbody>
        {{ range .Probes }}
        <tr>
            <td>{{ .Title }}<br><span class="muted">цель: {{ .Target }}</span></td>
            {{ if .Err }}
            <td colspan="4">{{ .Err }}</td>
            {{ else }}
            <td>{{ .Loss }}{{ if .Burst }}<br><span class="muted">{{ .Burst }}</span>{{ end }}</td>
            <td>{{ .RTT }}</td><td>{{ .Jitter }}</td>
            <td>{{ .Grade }}<br><span class="muted">{{ .Why }}</span></td>
            {{ end }}
            <td class="muted">{{ .Note }}</td>
        </tr>
        {{ end }}
        </tbody>
    </table>
    <ul class="check-facts">
        <li>Отброшено очередями сервера за время проверки: <strong>{{ .Queue }}</strong></li>
        {{ if .Tariff }}<li>Тариф в настройках: {{ .Tariff }}; потолок очереди внутри канала: {{ .Ceiling }}</li>{{ end }}
        <li>Ядер процессора: {{ .Cores }}, наибольшая нагрузка за проверку: {{ .Load }}</li>
        {{ if .HasSpeed }}
        <li>Скорость через канал: <strong>{{ if .Speed }}{{ .Speed }}{{ else }}измерить не удалось{{ end }}</strong>{{ if .Sources }} (ответили: {{ .Sources }}){{ end }}</li>
        <li>Базовая линия без канала: {{ .Baseline }}</li>
        {{ if .SpeedErr }}<li>{{ .SpeedErr }}</li>{{ end }}
        {{ end }}
        {{ range .Notes }}<li>{{ . }}</li>{{ end }}
    </ul>
            <p class="muted">Проверка шлёт пять пакетов в секунду, а настоящий
            разговор — пятьдесят. Поэтому показанные потери — это <strong>нижняя
            граница</strong>: измерено одновременно на боевом канале — проверка
            показала 4,8 %, разговор в ту же минуту терял 7,6 %.</p>
            <p class="muted">Полосы качества — общепринятые: «цель» — как у оператора
            связи (потери до 0,5 %, задержка до 100 мс в одну сторону), «приемлемо» —
            разговор идёт без жалоб (до 1 % и до 150 мс). Полного отсутствия потерь в
            сети не бывает: одиночные пропуски программа связи прячет незаметно, а
            вот потери пачками слышны как провалы в речи — поэтому характер потерь
            показан отдельно.</p>
            <p class="muted">Скорость через канал имеет смысл только вместе с тремя
            числами выше: тарифом, потолком нашей очереди и числом отброшенных
            пакетов. Если скорость упёрлась в потолок очереди — измерена настройка, а
            не канал; если очереди отбросили ноль пакетов, а скорость всё равно ниже
            базовой линии — ограничение находится на пути к серверу поставщика.</p>
        </div>
    </details>
</section>
{{ end }}{{ end }}{{ end }}

{{ if .pathKnown }}
<section class="card">
    <div class="card-head">
        <div>
            <h2>Наблюдение пути</h2>
            <p class="muted card-sub">Одна проба около раза в секунду: в защищённом режиме — только внутри
            канала, мимо канала не уходит ни одного пакета; в прямом доступе — до тех же серверов имён,
            к которым и так идут запросы. Тревога — только при смене состояния.</p>
        </div>
    </div>
    {{ if .paths }}
    <table>
        <thead><tr><th>Путь</th><th>Карта</th><th>Цели</th><th>Состояние</th><th>Задержка</th><th>Потери</th><th>С</th></tr></thead>
        <tbody>
            {{ range .paths }}
            <tr>
                <td>{{ .Name }}</td>
                <td><code>{{ .Iface }}</code></td>
                <td><code>{{ .Targets }}</code>{{ if .Chosen }} <span class="muted">({{ .Chosen }})</span>{{ end }}</td>
                <td>{{ if .Up }}<span class="tag tag-ok">{{ .State }}</span>{{ else }}<span class="tag tag-error">{{ .State }}</span>{{ end }}</td>
                <td>{{ if .RTT }}{{ .RTT }}{{ else }}—{{ end }}</td>
                <td>{{ .Loss }}</td>
                <td>{{ .Since }}</td>
            </tr>
            {{ end }}
        </tbody>
    </table>
    {{ else }}
    <p class="muted">Путей для наблюдения сейчас нет: нет ни действующего WAN, ни поднятого канала.</p>
    {{ end }}
    {{ if .resolverServers }}
    <p class="muted">Задержка серверов имён по кэшу резолвера шлюза (в защищённом
    режиме запросы идут через канал):{{ range .resolverServers }} <code>{{ . }}</code>{{ end }}.</p>
    {{ end }}
    {{ if .underlayRTT }}
    <p class="muted">Путь до сервера канала мимо канала (подложка) по последнему замеру
    прямого режима: {{ .underlayRTT }} мс, {{ .underlayAge }} назад{{ if not .underlayFresh }} — <span class="state-down">замер устарел</span>, вердикт о цене канала не выносится{{ end }}.</p>
    {{ end }}
    {{ if .probeSlug }}
    <form method="post" action="/vpn/probe-target" data-unsaved>
        <input type="hidden" name="_csrf" value="{{ .csrf }}">
        <input type="hidden" name="slug" value="{{ .probeSlug }}">
        {{ template "components/field" .fieldProbeTarget }}
        {{ template "components/button" .buttonProbeTarget }}
    </form>
    {{ end }}
</section>
{{ end }}

<section class="card">
    <details class="fold">
        <summary>{{ template "components/icon" "chevron" }}Расширенные настройки <span class="tag">размер пакетов, серверы имён, время</span></summary>
        <div class="fold-body">
            
            <div class="setting">
                <div>
                    <label class="setting-title" for="vpn-mtu-value">Размер пакетов (MTU){{ if .appliedMTU }} <span class="tag">сейчас {{ .appliedMTU }}{{ if .mtuAuto }}, подобран автоматически{{ end }}</span>{{ end }}</label>
                    <p class="setting-text">Пустое поле — панель подбирает сама. Меняйте, только если сайты «начинают
                    открываться и виснут»: это признак того, что крупные пакеты по пути пропадают. «Подобрать»
                    измеряет путь до сервера и внутри канала и предлагает число; до полминуты, не чаще раза в минуту.
                    На качество звука размер пакетов не влияет.</p>
                </div>
                <div class="setting-ctl">
                    <input type="number" id="vpn-mtu-value" class="input-days" name="mtu" form="vpn-apply" min="{{ .minMTU }}" max="{{ .maxMTU }}"
                           value="{{ if .mtu }}{{ .mtu }}{{ end }}" placeholder="авто">
                    <button type="submit" class="btn btn-secondary btn-small" form="vpn-mtu">Подобрать</button>
                </div>
            </div>
            {{ if .profiles }}
            <div class="setting setting-wide">
                <div>
                    <div class="setting-title">Серверы имён</div>
                    <p class="setting-text">Кто отвечает на запросы имён в защищённом режиме. Сервер из
                    файла подключения по умолчанию не применяется: иначе провайдер или
                    поставщик увидит, какие сайты открывает офис.</p>
                </div>
                {{ template "components/choice-card" .dnsCards }}
            </div>
            {{ end }}
            <div class="setting">
                <div>
                    <div class="setting-title">Время сервера</div>
                    <p class="setting-text">Если часы сервера уходят (обычная причина — севшая батарейка на плате),
                    сервер поставщика отклоняет подключение, а штатная синхронизация не проходит — её запрос
                    уходит в неработающий канал. Проверка спрашивает время в обход канала, правит часы и
                    записывает их в плату.</p>
                </div>
                <div class="setting-ctl">
                    <button type="submit" class="btn btn-secondary btn-small" form="vpn-timesync">Проверить время сервера</button>
                </div>
            </div>
            <div class="btn-row btn-row-end"><button type="submit" class="btn" form="vpn-apply">Применить</button></div>
        </div>
    </details>
</section>

<script src="{{ .static }}/js/vpn.js" defer></script>
{{ template "app-bottom" . }}
{{ end }}
